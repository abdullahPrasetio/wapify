PORT=8000
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=wapify
DB_PORT=5432
JWT_SECRET=supersecretjwtkey_please_change_in_production
RESEND_API_KEY=re_placeholder_key

# License Management (Fase 5)
# Use 'go run cmd/keygen/main.go' to generate these
LICENSE_PRIVATE_KEY=
LICENSE_KEY=

# Rating — sync ke license server
# URL license server Anda (tanpa trailing slash)
LICENSE_SERVER_URL=https://your-license-server.com
# Interval minimum antar rating per user (dalam hari), default: 30
RATING_INTERVAL_DAYS=30

# Google OAuth (Fase 6)
# Buat credentials di https://console.cloud.google.com/ → APIs & Services → Credentials
# Authorized redirect URI: https://your-backend-domain/api/v1/auth/google/callback
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
