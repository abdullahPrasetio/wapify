FROM golang:1.22-alpine AS builder

WORKDIR /app

COPY go.mod .
COPY go.sum .
RUN go mod download

COPY . .

ARG LICENSE_PRIVATE_KEY
ENV LICENSE_PRIVATE_KEY=$LICENSE_PRIVATE_KEY

RUN go build -o /app/server cmd/server/main.go

FROM alpine:latest

WORKDIR /app

COPY --from=builder /app/server .

# Run migrations (assuming 'migrate' tool is available in build stage)
# You might need to install 'migrate' binary in the builder image
# or run migrations from your host or a separate migration container
# For simplicity, we assume migrations are handled externally for now.

CMD ["/app/server"]
