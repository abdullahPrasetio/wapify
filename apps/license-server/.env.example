# Port the license server listens on
PORT=9100

# PostgreSQL — gunakan DATABASE_URL atau isi per-field di bawah
# DATABASE_URL=postgres://user:password@localhost:5432/wapbolt_licenses?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=wapbolt_licenses
DB_SSLMODE=disable

# Ed25519 private key — generate with: cd backend && go run ./cmd/license keygen
LICENSE_PRIVATE_KEY=

# How long issued licenses are valid: 1month | 1year | lifetime  (default: 1year)
LICENSE_DURATION=1year

# Static key required in the X-Admin-Key header for /api/admin/* endpoints
ADMIN_API_KEY=change-me-to-a-long-random-string

# CORS: URL landing page (jangan pakai * di production)
# Contoh: https://wapbolt.io atau http://localhost:5173 untuk dev
CORS_ORIGINS=http://localhost:5173

# Gmail SMTP — gunakan App Password (bukan password biasa)
# Cara buat App Password: https://myaccount.google.com/apppasswords (butuh 2FA aktif)
GMAIL_USER=temancode@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Email admin untuk menerima copy setiap license yang diterbitkan
ADMIN_EMAIL=temancode@gmail.com
