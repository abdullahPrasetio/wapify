{
  "info": {
    "name": "Wapbolt Internal API",
    "description": "Koleksi lengkap API internal untuk mengelola Wapbolt."
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = wap.response.json();",
                  "if (wap.response.status === 200 && res.token) {",
                  "    wap.setEnv(\"token\", res.token);",
                  "    console.log(\"Access Token saved to environment!\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/login",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@wapbolt.io\",\n  \"password\": \"admin123\"\n}"
            }
          }
        },
        {
          "name": "Get Profile (Me)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/auth/me",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ]
          }
        }
      ]
    },
    {
      "name": "Teams",
      "item": [
        {
          "name": "List My Teams",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/teams",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ]
          }
        },
        {
          "name": "Create Team",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/teams",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Support Team\",\n  \"description\": \"Team for customer support\"\n}"
            }
          }
        },
        {
          "name": "List Team Members",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/teams/{{teamId}}/members",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ]
          }
        }
      ]
    },
    {
      "name": "Collections",
      "item": [
        {
          "name": "List Team Collections",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/teams/{{teamId}}/collections",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ]
          }
        },
        {
          "name": "Create Collection",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/teams/{{teamId}}/collections",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Wapbolt Docs\",\n  \"description\": \"API documentation for Wapbolt\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Environments",
      "item": [
        {
          "name": "List Team Environments",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/teams/{{teamId}}/environments",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ]
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "List All Users",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/admin/users",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ]
          }
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/admin/users",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newuser@wapbolt.io\",\n  \"name\": \"New Staff\",\n  \"password\": \"staff123\",\n  \"initial_team_id\": {{teamId}},\n  \"role\": \"editor\"\n}"
            }
          }
        }
      ]
    }
  ]
}
